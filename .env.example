VITE_API_BASE_URL=http://localhost:8787
APP_MODE=self-hosted
DATABASE_DRIVER=sqlite
API_PORT=8787
CORS_ORIGINS=http://localhost:9000
AUTH_DB_PATH=./data/auth.sqlite
STORAGE_DIR=./data/files
CATALOG_JSON_PATH=./catalog/catalog.json
PUBLIC_BASE_URL=http://localhost:8787
SETUP_TOKEN=
JWT_SECRET=replace-with-a-long-random-secret
MODERATION_API_TOKEN=
# Optional PKCS#8 RSA private key in one line or with literal \n escapes.
# When set, Ygg textures properties include a Mojang-compatible signature.
YGG_TEXTURE_PRIVATE_KEY=
YGG_TEXTURE_PUBLIC_KEY=
MICROSOFT_CLIENT_ID=
OAUTH_ENCRYPTION_KEY=replace-with-a-second-long-random-secret

# Optional: server-only CurseForge API credential for external dependencies.
CURSEFORGE_API_KEY=
